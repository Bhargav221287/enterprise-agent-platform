# Enterprise Agent Platform Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO

# Orchestrator
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8000
VERIFIER_URL=http://localhost:8001
DOMAIN_PACKS_DIR=domain_packs
DATA_DIR=data

# LLM Configuration
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=mock-key
LLM_MOCK_LATENCY=0.01

# Verifier
VERIFIER_HOST=0.0.0.0
VERIFIER_PORT=8001
EXECUTION_TIMEOUT_SECONDS=3.0

# OpenTelemetry / Jaeger
OTEL_SERVICE_NAME=enterprise-agent-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_UI_URL=http://localhost:16686
